{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Audio Switcher",
  "version": "0.1.1",
  "identifier": "local.audio.switcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Audio Switcher",
        "width": 360,
        "height": 480,
        "center": true,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "resizable": false,
        "skipTaskbar": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE4RkNEQUUzQzRGMzQ0RDEKUldUUlJQUEU0OXI4cUUwT0orQTNBVG1OV3dBUkduU25od3pGS1FGYUZXUzV4S3Z0d09YZkRjK0sK",
      "endpoints": [
        "https://github.com/aixinxino/audio-switcher/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
